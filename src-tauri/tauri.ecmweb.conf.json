{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PC Vue Demo - ECM Web",
  "version": "0.1.0",
  "identifier": "com.pcvuedemo.desktop.ecmweb",
  "build": {
    "beforeDevCommand": "pnpm -C ecmweb dev --host 0.0.0.0",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "pnpm -C ecmweb build",
    "frontendDist": "../ecmweb/dist"
  },
  "app": {
    "windows": [
      {
        "title": "PC Vue Demo - ECM Web",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
